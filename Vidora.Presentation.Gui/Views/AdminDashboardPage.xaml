<Page
    x:Class="Vidora.Presentation.Gui.Views.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vidora.Presentation.Gui.Views"
    xmlns:vm="using:Vidora.Presentation.Gui.ViewModels"
    xmlns:converter="using:Vidora.Presentation.Gui.Converters"
    xmlns:core="using:Vidora.Core.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:RevenueToPointsConverter x:Key="RevenueConverter"/>
        <!-- COLOR PALETTE -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#000000"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#121212"/>
        <SolidColorBrush x:Key="VidoraRedBrush" Color="#D81F26"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#46D369"/>
        <SolidColorBrush x:Key="TextGrayBrush" Color="#A1A1A1"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#2A2A2A"/>

        <!-- STYLES -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <!-- Margin sẽ được xử lý trong Grid -->
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" Margin="0, 20">

        <!-- RESPONSIVE VISUAL STATES -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">

                <!-- 1. WIDE / DESKTOP (>= 1100px) -->
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100"/>
                    </VisualState.StateTriggers>

                </VisualState>


                <!-- 2. NARROW / TABLET (700px → 1099px) -->
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>



                        <!-- Hai card đứng 2 hàng -->
                        <Setter Target="StatCard1.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard1.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="StatCard1.Margin" Value="0,15,15,0"/>

                        <Setter Target="StatCard2.(Grid.Column)" Value="2"/>
                        <Setter Target="StatCard2.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="StatCard2.Margin" Value="0,15,0,0"/>

                        <!-- Card 3,4 xuống hàng sau -->
                        <Setter Target="StatCard3.(Grid.Row)" Value="1"/>
                        <Setter Target="StatCard3.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard3.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="StatCard3.Margin" Value="0,15,15,0"/>

                        <Setter Target="StatCard4.(Grid.Row)" Value="1"/>
                        <Setter Target="StatCard4.(Grid.Column)" Value="2"/>
                        <Setter Target="StatCard4.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="StatCard4.Margin" Value="0,15,0,0"/>
                    </VisualState.Setters>
                </VisualState>


                <!-- 3. MOBILE (< 700px) -->
                <VisualState x:Name="MobileLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>



                        <!-- 4 cards xếp dọc full width -->
                        <Setter Target="StatCard1.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="StatCard1.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard1.(Grid.Row)" Value="0"/>
                        <Setter Target="StatCard1.Margin" Value="0,10,0,0"/>

                        <Setter Target="StatCard2.(Grid.Row)" Value="1"/>
                        <Setter Target="StatCard2.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard2.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="StatCard2.Margin" Value="0,15,0,0"/>

                        <Setter Target="StatCard3.(Grid.Row)" Value="2"/>
                        <Setter Target="StatCard3.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard3.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="StatCard3.Margin" Value="0,15,0,0"/>

                        <Setter Target="StatCard4.(Grid.Row)" Value="3"/>
                        <Setter Target="StatCard4.(Grid.Column)" Value="0"/>
                        <Setter Target="StatCard4.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="StatCard4.Margin" Value="0,15,0,0"/>

                        <!-- Main sections -->
                        <Setter Target="MiddleRightSection.(Grid.Row)" Value="4"/>
                        <Setter Target="MiddleRightSection.(Grid.Column)" Value="0"/>
                        <Setter Target="MiddleRightSection.Margin" Value="0,20,0,0"/>

                        <Setter Target="BottomRightSection.(Grid.Row)" Value="5"/>
                        <Setter Target="BottomRightSection.(Grid.Column)" Value="0"/>
                        <Setter Target="BottomRightSection.Margin" Value="0,20,0,0"/>

                        <!-- Page padding -->
                        <Setter Target="MainScrollViewer.Padding" Value="12"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= MAIN CONTENT ================= -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel Spacing="25">

                <!-- 1. HEADER -->  
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Welcome back! Here's your Vidora overview" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="12,6">
                        <TextBlock Text="{x:Bind ViewModel.CurrentDate}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12"/>
                    </Border>
                </Grid>

                <!-- 2. STATS CARDS GRID -->
                <!-- Định nghĩa nhiều Row/Col để responsive mapping vào -->
                <Grid x:Name="StatsGrid" ColumnSpacing="0" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Col 2: Dùng cho Desktop -->
                        <ColumnDefinition Width="*"/>
                        <!-- Col 3: Dùng cho Desktop -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Dùng cho Tablet -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Dùng cho Mobile -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: Dùng cho Mobile -->
                    </Grid.RowDefinitions>

                    <!-- Card 1 -->
                    <Border x:Name="StatCard1" Grid.Column="0" Grid.Row="0" Style="{StaticResource StatCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,15,0" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Total Movies" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="TotalMoviesText" Text="{x:Bind ViewModel.Stats.TotalMovies}" Style="{StaticResource CardValueStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="+12.5%" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12"/>
                                <TextBlock Text="vs last month" Foreground="{StaticResource TextGrayBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Background="#260F0F" CornerRadius="6">
                                <FontIcon Glyph="&#xE8B2;" Foreground="{StaticResource VidoraRedBrush}" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border x:Name="StatCard2" Grid.Column="1" Grid.Row="0" Style="{StaticResource StatCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,15,0" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Users" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="TotalUsersText" Text="{x:Bind ViewModel.Stats.TotalUsers}" Style="{StaticResource CardValueStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <TextBlock Text="+15%" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12"/>
                                <TextBlock Text="Total accounts" Foreground="{StaticResource TextGrayBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Background="#260F0F" CornerRadius="6">
                                <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource VidoraRedBrush}" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border x:Name="StatCard3" Grid.Column="2" Grid.Row="0" Style="{StaticResource StatCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,15,0" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Today's Views" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="TotalViewsText" Text="{x:Bind ViewModel.Stats.TodayViews}" Style="{StaticResource CardValueStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="+23.99%" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12"/>
                                <TextBlock Text="Last 24 hours" Foreground="{StaticResource TextGrayBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Background="#260F0F" CornerRadius="6">
                                <FontIcon Glyph="&#xE7B3;" Foreground="{StaticResource VidoraRedBrush}" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 4 -->
                    <Border x:Name="StatCard4" Grid.Column="3" Grid.Row="0" Style="{StaticResource StatCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Monthly Revenue" Style="{StaticResource CardTitleStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="RevenueText" Text="{x:Bind ViewModel.Stats.MonthlyRevenue}" Style="{StaticResource CardValueStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="+18.99%"  Foreground="{StaticResource SuccessGreenBrush}" FontSize="12"/>
                                <TextBlock Text="USD" Foreground="{StaticResource TextGrayBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Background="#260F0F" CornerRadius="6">
                                <FontIcon Glyph="&#xE4AE;" Foreground="{StaticResource VidoraRedBrush}" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. MIDDLE SECTION (Chart & Plans) -->
                <!-- ColumnSpacing 20, nhưng dùng VSM để biến Row thành cột khi màn hình nhỏ -->
                <Grid x:Name="MiddleGrid" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Row dự phòng cho mobile -->
                    </Grid.RowDefinitions>

                    <!-- Revenue Chart -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Monthly Revenue" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Revenue chart for the last 30 days" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,20,0,0" Height="200">
                                <StackPanel VerticalAlignment="Stretch" Spacing="40">
                                    <Border BorderBrush="#333" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#333" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#333" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#333" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#333" BorderThickness="0,1,0,0"/>
                                </StackPanel>
                                <Polyline 
                                    Points="{x:Bind ViewModel.Stats.RevenueData, Mode=OneWay, Converter={StaticResource RevenueConverter}}"
                                    Stroke="{StaticResource VidoraRedBrush}" 
                                    StrokeThickness="3" 
                                    VerticalAlignment="Bottom" 
                                    Stretch="Fill" 
                                    StrokeLineJoin="Round"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Column: New Signups & Popular Plans -->
                    <!-- Đặt tên MiddleRightSection để VSM điều khiển -->
                    <StackPanel x:Name="MiddleRightSection" Grid.Column="1" Spacing="20" >
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE77B;" Foreground="{StaticResource SuccessGreenBrush}"/>
                                        <TextBlock Text="New Signups" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="Today" Foreground="{StaticResource TextGrayBrush}" FontSize="11" Margin="26,-4,0,0"/>
                                    <TextBlock x:Name="NewSignupsText" Text="{x:Bind ViewModel.Stats.TotalTodayNewUsers}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,15,0,0"/>
                                    <TextBlock Text="+32.99%"  Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recent Signups -->
                        <!-- Đặt tên BottomRightSection để VSM điều khiển -->
                        <Border x:Name="BottomRightSection" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Recent Signups" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="3 Latest Signups" 
                   Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="0,4,0,20"/>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Stats.NewUsers, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:User">
                                            <StackPanel>
                                                <Grid Margin="0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <PersonPicture DisplayName="{x:Bind FullName}" 
                                           ProfilePicture="{x:Bind Avatar}" 
                                           Width="32" Margin="0,0,10,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FullName}" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                           FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Email}" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                           FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Rectangle Height="1" Fill="#222" Margin="0,5"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4. BOTTOM LISTS -->
                <Grid x:Name="BottomGrid" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Top 5 Most Watched Movies" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Ranked by total views" Foreground="{StaticResource TextGrayBrush}" FontSize="12" Margin="0,4,0,20"/>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Stats.MostWatchedMovies, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:Movie">
                                        <StackPanel>
                                            <Grid Margin="0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{StaticResource VidoraRedBrush}" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Background="#333" CornerRadius="2" Padding="4,0">
                                                            <TextBlock Text="Movie" Foreground="#CCC" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="★ 4.8" Foreground="#FFD700" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                            <Rectangle Height="1" Fill="#222" Margin="0,5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>