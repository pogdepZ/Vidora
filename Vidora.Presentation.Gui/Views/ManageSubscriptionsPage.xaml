<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vidora.Presentation.Gui.Views.ManageSubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vidora.Presentation.Gui.Views"
    xmlns:results="using:Vidora.Core.Contracts.Results"
    xmlns:vm="using:Vidora.Presentation.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent" Margin="0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== INFOBAR THÔNG BÁO ===== -->
        <InfoBar x:Name="NotificationInfoBar"
                 Grid.Row="0" 
                 Grid.RowSpan="2" 
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0"
                 Canvas.ZIndex="999"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Success"
                 Width="500"/>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0" Padding="40,30,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="10">
                <TextBlock Text="Manage Subscriptions, Promos &amp; Orders"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Foreground="Gray" FontSize="14">
                    <Run Text="Subscription Plans: "/>
                    <Run Text="{x:Bind ViewModel.Plans.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" | Promo Codes: "/>
                    <Run Text="{x:Bind ViewModel.TotalPromos, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" | Orders: "/>
                    <Run Text="{x:Bind ViewModel.TotalOrders, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <!-- Add Promo Button -->
            <Button Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddPromoClick"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Add Promo Code"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== CONTENT ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Padding="40,0,40,40">
                
                <!-- ===== SECTION: SUBSCRIPTION PLANS ===== -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <!-- Section Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Subscription Plans" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="List of available subscription plans" Foreground="Gray" FontSize="13"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.LoadPlansCommand}"
                                    ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <!-- Plans Grid -->
                        <Grid HorizontalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPlans, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoadingPlans, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                            
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoadingPlans, Converter={StaticResource BoolToVisibilityConverterInvert}, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="results:SubscriptionPlanResult">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="20"
                                                MinWidth="250"
                                                HorizontalAlignment="Stretch"
                                                BorderBrush="{ThemeResource SystemAccentColorLight2}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="{x:Bind Name}" 
                                                           FontSize="18" 
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind PriceDisplay}" 
                                                           FontSize="24" 
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind DurationsDisplay}" 
                                                           FontSize="14"
                                                           Foreground="Gray"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Description}" 
                                                           FontSize="12"
                                                           Foreground="Gray"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           MaxWidth="180"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== SECTION: ORDERS ===== -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid Grid.Row="0" Padding="24,24,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Orders" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="List of subscription orders" Foreground="Gray" FontSize="13"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.LoadOrdersCommand}"
                                    ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <!-- Search and Filter Bar -->
                        <Grid Grid.Row="1" Padding="24,0,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Box -->
                            <TextBox Grid.Column="0"
                                     PlaceholderText="Search by name, email, plan..."
                                     Text="{x:Bind ViewModel.OrderSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     
                                     HorizontalAlignment="Stretch"
                                     KeyDown="OnOrderSearchKeyDown"/>

                            <!-- Status Filter -->
                            <ComboBox Grid.Column="1"
                                      x:Name="OrderStatusComboBox"
                                      Header="Status"
                                      Margin="16,0,0,0"
                                      MinWidth="150"
                                      ItemsSource="{x:Bind ViewModel.OrderStatusOptions}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnOrderStatusSelectionChanged"/>

                            <!-- Plan Filter -->
                            <ComboBox Grid.Column="2"
                                      x:Name="OrderPlanComboBox"
                                      Header="Subscription Plan"
                                      Margin="16,0,0,0"
                                      MinWidth="150"
                                      ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="PlanId"
                                      PlaceholderText="All"
                                      SelectionChanged="OnOrderPlanSelectionChanged"/>

                            <!-- Clear Filters Button -->
                            <Button Grid.Column="3"
                                    Margin="16,20,0,0"
                                    Command="{x:Bind ViewModel.ClearOrderFiltersCommand}"
                                    ToolTipService.ToolTip="Clear Filters">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- Table Header -->
                        <Grid Grid.Row="2"
                              Padding="24,10"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ORDER CODE" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="CUSTOMER" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="PLAN" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="PAYMENT" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="PAID DATE" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="ACTION" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" Margin="10,0"/>
                        </Grid>

                        <!-- Orders List -->
                        <Grid Grid.Row="3" MinHeight="200">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingOrders, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoadingOrders, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

                            <!-- Empty State -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsLoadingOrders, Converter={StaticResource BoolToVisibilityConverterInvert}, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No orders found"
                                           Foreground="Gray"
                                           FontSize="14"
                                           Visibility="{x:Bind ViewModel.Orders.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverterInvert}}"/>
                            </StackPanel>
                            
                            <ListView ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      Visibility="{x:Bind ViewModel.IsLoadingOrders, Converter={StaticResource BoolToVisibilityConverterInvert}, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="results:OrderResult">
                                        <Grid Padding="24,14"
                                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                              BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Order Code -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind OrderCode}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- User Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind UserFullName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind UserEmail}"
                                                           FontSize="11"
                                                           Foreground="Gray"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Plan Name -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind PlanName}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"/>

                                            <!-- Final Amount -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind FinalAmountDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"/>

                                            <!-- Status -->
                                            <Border Grid.Column="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="10,4"
                                                    CornerRadius="4"
                                                    Background="{x:Bind StatusColor, Converter={StaticResource StatusToBackgroundConverter}}">
                                                <TextBlock Text="{x:Bind StatusDisplay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Paid At -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind PaidAtDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="Gray"/>

                                            <!-- View Details Button -->
                                            <Button Grid.Column="6"
                                                    Click="OnViewOrderDetailsClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="View Details"
                                                    Padding="8,6"
                                                    Margin="10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                                    <TextBlock Text="Details" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Pagination -->
                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12"
                                    Padding="24">
                            <Button Content="◀" 
                                    Command="{x:Bind ViewModel.ChangeOrderPageCommand}" 
                                    CommandParameter="Prev"
                                    IsEnabled="{x:Bind ViewModel.CanGoOrderPrev, Mode=OneWay}"/>

                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Page "/>
                                <Run Text="{x:Bind ViewModel.OrderCurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind ViewModel.OrderTotalPages, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>

                            <Button Content="▶" 
                                    Command="{x:Bind ViewModel.ChangeOrderPageCommand}" 
                                    CommandParameter="Next"
                                    IsEnabled="{x:Bind ViewModel.CanGoOrderNext, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== SECTION: PROMO CODES ===== -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <!-- ...existing promo codes section... -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid Grid.Row="0" Padding="24,24,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Promo Codes" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Manage promo codes" Foreground="Gray" FontSize="13"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.LoadPromosCommand}"
                                    ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <!-- Table Header -->
                        <Grid Grid.Row="1"
                              Padding="24,10"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CODE" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="TYPE" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="VALUE" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="MIN ORDER" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="MAX DISCOUNT" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="DURATION" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="STATUS" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Promo List -->
                        <Grid Grid.Row="2" MinHeight="200">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPromos, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoadingPromos, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                            
                            <ListView ItemsSource="{x:Bind ViewModel.Promos, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      Visibility="{x:Bind ViewModel.IsLoadingPromos, Converter={StaticResource BoolToVisibilityConverterInvert}, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="results:PromoResult">
                                        <Grid Padding="24,14"
                                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                              BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Code -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Code}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>

                                            <!-- Type -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DiscountTypeDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"/>

                                            <!-- Value -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind ValueDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"/>

                                            <!-- Min Order -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind MinOrderValueDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="Gray"/>

                                            <!-- Max Discount -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind MaxDiscountDisplay}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="Gray"/>

                                            <!-- Date Range -->
                                            <StackPanel Grid.Column="5" 
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock FontSize="11" Foreground="Gray">
                                                    <Run Text="{x:Bind StartDateDisplay}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{x:Bind EndDateDisplay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Status -->
                                            <Border Grid.Column="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="10,4"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                                <TextBlock Text="{x:Bind StatusDisplay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Pagination -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12"
                                    Padding="24">
                            <Button Content="◀" 
                                    Command="{x:Bind ViewModel.ChangePageCommand}" 
                                    CommandParameter="Prev"
                                    IsEnabled="{x:Bind ViewModel.CanGoPrev, Mode=OneWay}"/>

                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Page "/>
                                <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>

                            <Button Content="▶" 
                                    Command="{x:Bind ViewModel.ChangePageCommand}" 
                                    CommandParameter="Next"
                                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
